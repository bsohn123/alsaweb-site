{
  // Configuration Cloudflare : le site statique, plus un Worker (src/worker.js)
  // pour la maquette automatique. Voir README.md, partie « Maquette automatique ».
  "name": "alsaweb-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Le Worker passe en premier pour reconnaître /api, /admin, /m et les sous-domaines de maquette ;
    // tout le reste est servi tel quel depuis le dépôt.
    "run_worker_first": true
  },
  "vars": {
    "DOMAINE": "alsaweb.fr",
    // Passer à "1" une fois le DNS joker *.alsaweb.fr et la route du Worker ajoutés (README, étape 5).
    // Tant que c'est "0", les maquettes sont servies sur alsaweb.fr/m/<nom>.
    "SOUS_DOMAINES": "0",
    "EMAIL_EXPEDITEUR": "Baptiste, Alsaweb <maquette@alsaweb.fr>",
    "EMAIL_BAPTISTE": "contact@alsaweb.fr"
  }
  // Étape 1 du README : créer l'espace KV puis décommenter ce bloc avec son identifiant.
  // Tant qu'il est commenté, le site fonctionne et le formulaire de maquette passe par Formspree.
  // ,"kv_namespaces": [
  //   { "binding": "MAQUETTES", "id": "COLLER_ICI_L_IDENTIFIANT_DU_KV" }
  // ]
}
