/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/exemples/*
  X-Robots-Tag: noindex

/instagram/*
  X-Robots-Tag: noindex

/labo/*
  X-Robots-Tag: noindex

/*.jpg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

# Feuilles de style et scripts : le navigateur redemande toujours s'ils ont changé
# (réponse « 304 » très légère sinon). Évite d'afficher un ancien CSS après une mise en ligne.
# Dans les pages, chaque fichier porte aussi un ?v=AAAAMMJJ à changer à chaque modification.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/legal.css
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: no-cache
